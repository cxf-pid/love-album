# =============================================
# 陈彪 & 王莎莎 · 时光胶片 — 环境变量配置
# 将本文件复制为 .env.local 并填入真实值
# =============================================

# ----- Cloudflare R2 对象存储 -----
# 在 Cloudflare Dashboard → R2 → 创建 Bucket → 获取凭证
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=love-album
R2_PUBLIC_DOMAIN=https://<your-bucket>.<your-account-id>.r2.cloudflarestorage.com
# 也可以绑定自定义域名: https://cdn.yourdomain.com

# ----- Supabase 数据库 -----
# 在 Supabase Dashboard → Settings → API 获取
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>
# ⚠️ SERVICE_KEY 有完全数据库权限，仅用于云函数（后端），不要暴露在前端

# ----- 前端环境变量（Vite 用 VITE_ 前缀暴露给浏览器）-----
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
# Anon Key 是公开的，权限由 Supabase RLS 策略控制
